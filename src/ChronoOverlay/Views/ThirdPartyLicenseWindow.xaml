<Window x:Class="ChronoOverlay.Views.ThirdPartyLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChronoOverlay 第三方许可"
        Width="760"
        Height="640"
        MinWidth="520"
        MinHeight="420"
        Background="#FF151A20"
        Foreground="#FFE6EBF0"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="第三方许可"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="#FF9EA8B5"
                       TextWrapping="Wrap"
                       Text="内置字体的版权所有者、上游地址与完整 SIL OFL 1.1 文本。内容可选择复制，且完全离线可用。" />
        </StackPanel>

        <TextBox x:Name="LicenseTextBox"
                 Grid.Row="1"
                 Padding="14"
                 Background="#FF0F1318"
                 Foreground="#FFDCE2E8"
                 BorderBrush="#FF303740"
                 BorderThickness="1"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="13"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" />

        <Button Grid.Row="2"
                Margin="0,14,0,0"
                Padding="22,8"
                HorizontalAlignment="Right"
                Content="关闭"
                IsDefault="True"
                Click="OnCloseClick" />
    </Grid>
</Window>
