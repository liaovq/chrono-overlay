<Window x:Class="ChronoOverlay.Views.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="#FFF4F6F8" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF9EA8B5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
            <Setter Property="Foreground" Value="#FFDCE2E8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFE6EBF0" />
            <Setter Property="Background" Value="#FF252B33" />
            <Setter Property="BorderBrush" Value="#FF39414B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF303842" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF596575" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF1D2228" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF75A7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFDCE2E8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" CornerRadius="8" Background="#01000000">
        <StackPanel>
            <Grid x:Name="ClockSurface" Margin="0">
                <Border Background="#FF000000"
                        CornerRadius="8"
                        Opacity="{Binding BackgroundOpacity}" />
                <StackPanel Margin="12,8,12,9" HorizontalAlignment="Right">
                    <TextBlock x:Name="TimeText"
                               Text="{Binding TimeText}"
                               Foreground="{Binding TextBrush}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="{Binding TimeFontSize}"
                               FontWeight="SemiBold"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               MouseLeftButtonDown="OnTimeMouseLeftButtonDown" />
                    <TextBlock Text="{Binding DateText}"
                               Foreground="{Binding TextBrush}"
                               FontSize="{Binding DateFontSize}"
                               FontWeight="Medium"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               Margin="0,-3,0,0" />
                </StackPanel>
            </Grid>

            <Border x:Name="ControlPanel"
                    Margin="0,6,0,0"
                    Padding="14"
                    Background="#F21A1F25"
                    BorderBrush="#FF303740"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid MinWidth="340">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource LabelStyle}" Text="时间字号" />
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="32" Maximum="128"
                            Value="{Binding TimeFontSize, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueStyle}"
                               Text="{Binding TimeFontSize, StringFormat={}{0:0}px}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource LabelStyle}" Text="日期字号" />
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="16" Maximum="64"
                            Value="{Binding DateFontSize, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueStyle}"
                               Text="{Binding DateFontSize, StringFormat={}{0:0}px}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}" Text="背景浓度" />
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.01"
                            Value="{Binding BackgroundOpacity, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueStyle}"
                               Text="{Binding BackgroundPercent, StringFormat={}{0}%}" />

                    <TextBlock Grid.Row="3" Style="{StaticResource LabelStyle}" Text="文字颜色" />
                    <Button Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Padding="10,5"
                            Content="纯黑" Click="OnBlackClick" />
                    <Border Grid.Row="3" Grid.Column="1" Margin="60,0,60,0" Height="16" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFF3B30" Offset="0" />
                                <GradientStop Color="#FFFFCC00" Offset="0.17" />
                                <GradientStop Color="#FF34C759" Offset="0.33" />
                                <GradientStop Color="#FF32ADE6" Offset="0.5" />
                                <GradientStop Color="#FF007AFF" Offset="0.67" />
                                <GradientStop Color="#FFAF52DE" Offset="0.83" />
                                <GradientStop Color="#FFFF3B30" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Slider Minimum="0" Maximum="360" Background="Transparent"
                                Value="{Binding Hue, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <Button Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Padding="10,5"
                            Content="纯白" Click="OnWhiteClick" />

                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2"
                              IsChecked="{Binding AutoStartEnabled, UpdateSourceTrigger=PropertyChanged}"
                              Content="开机自启" />
                    <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                            Background="#FF3B67D9" BorderBrush="#FF5A82E7" Padding="16,7"
                            Content="锁定" Click="OnLockClick" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
